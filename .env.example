# Chaîne de connexion à la base de données MySQL.
# Format : mysql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="mysql://user:password@localhost:3306/ludonyon"

# Fuseau horaire du serveur. Sans ça, un serveur configuré en UTC (le cas
# le plus courant) décale les heures affichées ET les horaires saisis à la
# création d'un événement (le champ "Début" du formulaire est interprété
# dans le fuseau du serveur, pas celui de la personne qui le remplit).
TZ="Europe/Zurich"

# Clé secrète utilisée par NextAuth pour signer les sessions.
# Générez-en une avec: openssl rand -base64 32
AUTH_SECRET=""

# Adresse publique complète du site en production, ex.
# "https://benevoles.ludo-gland.ch". Nécessaire derrière un reverse proxy
# (comme Infomaniak) pour que les redirections de connexion/déconnexion
# utilisent le bon domaine plutôt que l'adresse interne. Pas nécessaire
# en développement local.
AUTH_URL=""

# Paire de clés VAPID pour les notifications push (Web Push).
# Générez-les avec: npx web-push generate-vapid-keys
# La clé publique est aussi exposée au navigateur (NEXT_PUBLIC_*), c'est
# normal — seule la clé privée doit rester secrète.
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:contact@ludonyonregion.ch"

# Serveur SMTP pour l'envoi automatique de l'email de bienvenue (identifiants
# de connexion) à la création d'un compte bénévole. Tant que ces variables
# ne sont pas toutes renseignées, aucun email n'est envoyé (les identifiants
# doivent être communiqués manuellement) — voir Espace organisation >
# Paramètres pour le statut actuel.
#
# Avec un compte Office 365 : hôte smtp.office365.com, port 587 (STARTTLS,
# donc SMTP_SECURE="false"), SMTP_USER = l'adresse complète du compte,
# SMTP_PASSWORD = son mot de passe (ou un mot de passe d'application si le
# compte a la double authentification). L'authentification SMTP doit être
# activée pour ce compte dans le centre d'administration Microsoft 365
# (Utilisateurs > utilisateur actif > Courrier > Gérer les paramètres
# d'email > Authentification SMTP activée) — souvent désactivée par défaut.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ludothèque Nyon Région <votre-compte@exemple.ch>"
