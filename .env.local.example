# Copie ce fichier en .env.local et remplis avec les identifiants de la base
# MariaDB fournie par Infomaniak (Manager > Bases de données).

DB_HOST=xxxxxxxxxxxx.myd.infomaniak.com
DB_PORT=3306
DB_USER=xxxxxxxxxxxx
DB_PASSWORD=xxxxxxxxxxxx
DB_NAME=xxxxxxxxxxxx

# Optionnel : uniquement pour le bouton "Classer les articles
# automatiquement" (dashboard > Vendeurs). Sans cette clé, le reste de
# l'appli fonctionne normalement.
ANTHROPIC_API_KEY=xxxxxxxxxxxx

# Optionnel : envoi par email de la confirmation vendeur (n° + QR + lien de
# modification de liste). Identifiants Infomaniak Mail (ou autre SMTP) —
# Manager > Mail. Sans ces identifiants, la soumission de liste continue de
# fonctionner normalement, l'email est juste sauté (log un avertissement).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxxxxx
SMTP_PASSWORD=xxxxxxxxxxxx
# Optionnel : adresse d'expéditeur affichée si différente de SMTP_USER.
SMTP_FROM=xxxxxxxxxxxx

# Optionnel : adresse prévenue en cas de blocage brute-force sur les
# formulaires de connexion (voir src/lib/rate-limit.ts). Par défaut :
# johannvilliger@ludonyonregion.ch — inutile de renseigner cette variable
# sauf pour utiliser une autre adresse.
ADMIN_EMAIL=xxxxxxxxxxxx
