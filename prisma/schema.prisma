// Ludonyon — schéma de base de données
// Association de bénévoles d'une ludothèque : bénévoles, annonces, événements et inscriptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Role est une chaîne validée côté application (voir src/lib/roles.ts)
// parmi "BENEVOLE" | "RESPONSABLE" | "COMITE".
model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String   @default("BENEVOLE")
  active                 Boolean  @default(true)
  phone                  String?
  skills                 String? // compétences / disponibilités en texte libre
  photoPath              String? // nom de fichier dans le dossier de stockage des photos, hors dépôt git
  calendarToken          String   @unique @default(cuid())
  wantsOpeningReminders  Boolean  @default(false)
  // Poste du bénévole pour le planning des ouvertures — "ACCUEIL" |
  // "RETOUR" | "SORTIE" | null. Fixé uniquement par un responsable/comité
  // (jamais par le bénévole lui-même), sert à filtrer qui est notifié
  // lors d'une recherche de remplaçant (hiérarchie : sortie > retour >
  // accueil, un poste supérieur peut couvrir les postes inférieurs).
  poste                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  announcements     Announcement[]
  events            Event[]
  signups           EventSignup[]
  vacations         Vacation[]
  taskAssignees     TaskAssignee[]
  pushSubscriptions PushSubscription[]
  openingShifts     OpeningShiftAssignee[]
  availabilities    VolunteerAvailability[]

  @@index([role])
}

// Créneaux du planning (voir src/lib/planning.ts) pour lesquels le
// bénévole se déclare disponible. slotKey = "<groupKey>:<site>", ex.
// "mercredi-apres-midi:GLAND" — utilisé pour cibler les notifications de
// recherche de remplaçant.
model VolunteerAvailability {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey String

  @@unique([userId, slotKey])
  @@index([slotKey])
}

// Historique des notifications push envoyées, toutes catégories
// confondues, consultable dans Espace organisation > Notifications.
// category : "MANUAL" | "EVENT_REMINDER" | "OPENING_REMINDER" |
// "REPLACEMENT_REQUEST" | "REPLACEMENT_PROBLEM".
model PushNotificationLog {
  id             String   @id @default(cuid())
  category       String
  title          String   @db.VarChar(255)
  body           String   @db.Text
  recipients     Int
  // Noms des destinataires au moment de l'envoi (liste figée, séparée par
  // des virgules) : un compte renommé ou supprimé par la suite ne modifie
  // pas l'historique déjà consigné.
  recipientNames String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Un abonnement par navigateur/appareil ayant activé les notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Périodes d'indisponibilité déclarées par le bénévole lui-même,
// visibles par les responsables/comité sur sa fiche.
model Vacation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// audience : chaîne validée côté application ("ALL" | "ORGANISATION").
// "ORGANISATION" = visible uniquement des responsables/comité (ex. relais
// d'une notification envoyée à ce public restreint).
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  paid        Boolean  @default(false)
  // Archivé plutôt que supprimé directement, pour ne jamais perdre les
  // présences/heures liées sans confirmation explicite (voir deleteEvent).
  active      Boolean  @default(true)
  // "ALL" | "COMITE". Une séance comité (audience "COMITE") est invisible
  // pour tout le monde sauf les membres du comité : listes, page de
  // gestion, ordre du jour et enregistrement audio (voir les vérifications
  // de rôle explicites, pas seulement un masquage dans l'UI).
  audience    String   @default("ALL")
  agenda      String?  @db.Text
  // Nom de fichier dans le dossier de stockage des enregistrements, hors
  // dépôt git ET hors public/ (jamais servi par une URL statique — voir
  // la route API dédiée qui vérifie le rôle avant de streamer le fichier).
  recordingPath String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  signups EventSignup[]
  tasks   Task[]
}

model EventSignup {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantsReminder      Boolean   @default(false)
  reminderSentAt     DateTime?
  seekingReplacement Boolean   @default(false)
  createdAt          DateTime  @default(now())

  attendanceSessions AttendanceSession[]

  @@unique([eventId, userId])
}

// Tâche optionnelle liée à un événement (pas tous les événements n'en ont).
model Task {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  assignees TaskAssignee[]

  @@index([eventId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// Un créneau d'ouverture (jour + site + période) tel que défini par la
// grille hebdomadaire fixe (voir src/lib/planning.ts). Créé à la demande
// dès qu'un·e bénévole y est assigné·e.
// site : "NYON" | "GLAND". période : "JOURNEE" | "MATIN" | "APREM".
model OpeningShift {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  site      String
  periode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees OpeningShiftAssignee[]

  @@unique([date, site, periode])
  @@index([date])
}

// Fermeture globale de la ludothèque (vacances scolaires, jours fériés
// exceptionnels, etc.), saisie par un·e responsable/comité et affichée sur
// le planning des ouvertures (public et gestion). Distincte des Vacation,
// qui sont l'indisponibilité d'un·e bénévole en particulier.
model PlanningClosure {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model OpeningShiftAssignee {
  id                     String       @id @default(cuid())
  shiftId                String
  shift                  OpeningShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Le bénévole reste responsable du créneau tant que ce champ est actif :
  // signaler un empêchement ne le retire pas automatiquement.
  seekingReplacement     Boolean      @default(false)
  replacementRequestedAt DateTime?
  // Rempli dès qu'une alerte "créneau à risque" a été envoyée aux
  // responsables/comité pour ce remplacement en attente, pour ne pas
  // renvoyer la même alerte à chaque vérification périodique. Remis à
  // null dès que la recherche est annulée ou relancée.
  problemAlertSentAt     DateTime?
  // Rempli dès que le rappel "la veille à 19h" a été envoyé pour cette
  // assignation, pour ne pas le renvoyer en cas de nouvelle vérification.
  reminderSentAt         DateTime?

  @@unique([shiftId, userId])
  @@index([userId])
}

// Un bénévole peut arriver/repartir plusieurs fois pendant un même
// événement : chaque présence est une session distincte, et le temps
// total est la somme des sessions.
model AttendanceSession {
  id            String      @id @default(cuid())
  eventSignupId String
  eventSignup   EventSignup @relation(fields: [eventSignupId], references: [id], onDelete: Cascade)
  arrivedAt     DateTime
  leftAt        DateTime?
  manual        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([eventSignupId])
}
