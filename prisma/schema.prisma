// Ludonyon — schéma de base de données
// Association de bénévoles d'une ludothèque : bénévoles, annonces, événements et inscriptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Role est une chaîne validée côté application (voir src/lib/roles.ts)
// parmi "BENEVOLE" | "RESPONSABLE" | "COMITE".
model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String   @default("BENEVOLE")
  active                 Boolean  @default(true)
  phone                  String?
  skills                 String? // compétences / disponibilités en texte libre
  photoPath              String? // nom de fichier dans le dossier de stockage des photos, hors dépôt git
  calendarToken          String   @unique @default(cuid())
  wantsOpeningReminders  Boolean  @default(false)
  // Dernière activité (connexion ou simple navigation sur une page,
  // limité à une écriture toutes les 5 minutes — voir le callback jwt
  // dans auth.ts). Visible dans Espace organisation > Bénévoles.
  lastSeenAt             DateTime?
  // Poste du bénévole pour le planning des ouvertures — "ACCUEIL" |
  // "RETOUR" | "SORTIE" | null. Fixé uniquement par un responsable/comité
  // (jamais par le bénévole lui-même), sert à filtrer qui est notifié
  // lors d'une recherche de remplaçant (hiérarchie : sortie > retour >
  // accueil, un poste supérieur peut couvrir les postes inférieurs).
  poste                  String?
  // Habits remis par la ludothèque — géré uniquement par les
  // responsables/comité (voir Espace organisation > Bénévoles). Taille et
  // coupe restent modifiables même sans l'avoir reçu : ça permet de savoir
  // directement lequel donner le jour où on en prête ou en remet un. Le
  // pull doit être rendu si le/la bénévole quitte l'association.
  poloReceived           Boolean  @default(false)
  poloSize               String?
  poloCut                String?
  pullReceived           Boolean  @default(false)
  pullSize               String?
  pullCut                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  announcements     Announcement[]
  events            Event[]
  signups           EventSignup[]
  vacations         Vacation[]
  taskAssignees     TaskAssignee[]
  pushSubscriptions PushSubscription[]
  openingShifts     OpeningShiftAssignee[]
  availabilities    VolunteerAvailability[]
  groupMemberships  GroupMembership[]

  @@index([role])
}

// Groupe d'activité librement défini par les responsables/comité (ex.
// "Déco/Brico", "Informatique") — indépendant du rôle — utilisé comme
// destinataire ciblé pour l'envoi d'une notification manuelle (voir
// Espace organisation > Notifications et Groupes).
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members       GroupMembership[]
  announcements Announcement[]
}

model GroupMembership {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// Créneaux du planning (voir src/lib/planning.ts) pour lesquels le
// bénévole se déclare disponible. slotKey = "<groupKey>:<site>", ex.
// "mercredi-apres-midi:GLAND" — utilisé pour cibler les notifications de
// recherche de remplaçant.
model VolunteerAvailability {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey String

  @@unique([userId, slotKey])
  @@index([slotKey])
}

// Historique des notifications push envoyées, toutes catégories
// confondues, consultable dans Espace organisation > Notifications.
// category : "MANUAL" | "EVENT_REMINDER" | "OPENING_REMINDER" |
// "REPLACEMENT_REQUEST" | "REPLACEMENT_PROBLEM" | "TASK_REMINDER" |
// "GROUP_PEER" (envoyée par un·e bénévole à son propre groupe, voir
// sendGroupNotification).
model PushNotificationLog {
  id             String   @id @default(cuid())
  category       String
  title          String   @db.VarChar(255)
  body           String   @db.Text
  recipients     Int
  // Noms des destinataires au moment de l'envoi (liste figée, séparée par
  // des virgules) : un compte renommé ou supprimé par la suite ne modifie
  // pas l'historique déjà consigné.
  recipientNames String?  @db.Text
  // Nom du groupe d'activité ciblé au moment de l'envoi, si la notification
  // a été envoyée à un groupe plutôt qu'à "Tous les bénévoles" ou
  // "Responsables et comité" — figé comme recipientNames, un groupe
  // renommé/supprimé ensuite ne modifie pas l'historique déjà consigné.
  targetGroupName String?  @db.VarChar(100)
  // Nom de la personne à l'origine de l'envoi, pour les catégories où ce
  // n'est pas forcément un·e responsable/comité (ex. GROUP_PEER) — figé
  // comme les autres noms de cette table.
  authorName      String?  @db.VarChar(200)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Un abonnement par navigateur/appareil ayant activé les notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Périodes d'indisponibilité déclarées par le bénévole lui-même,
// visibles par les responsables/comité sur sa fiche.
model Vacation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// audience : chaîne validée côté application ("ALL" | "ORGANISATION" |
// "GROUP"). "ORGANISATION" = visible uniquement des responsables/comité
// (ex. relais d'une notification envoyée à ce public restreint). "GROUP"
// = visible uniquement des membres du groupe désigné par groupId (en plus
// des responsables/comité, qui voient toutes les annonces) — relais d'une
// notification envoyée à un groupe d'activité (voir sendManualNotification).
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  // Groupe ciblé si audience = "GROUP" — remis à null si le groupe est
  // supprimé (l'annonce reste dans l'historique de gestion mais redevient
  // invisible pour les bénévoles, faute d'audience identifiable).
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  paid        Boolean  @default(false)
  // Archivé plutôt que supprimé directement, pour ne jamais perdre les
  // présences/heures liées sans confirmation explicite (voir deleteEvent).
  active      Boolean  @default(true)
  // "ALL" | "COMITE". Une séance comité (audience "COMITE") est invisible
  // pour tout le monde sauf les membres du comité : listes, page de
  // gestion, ordre du jour et enregistrement audio (voir les vérifications
  // de rôle explicites, pas seulement un masquage dans l'UI).
  audience    String   @default("ALL")
  agenda      String?  @db.Text
  // Nom de fichier dans le dossier de stockage des enregistrements, hors
  // dépôt git ET hors public/ (jamais servi par une URL statique — voir
  // la route API dédiée qui vérifie le rôle avant de streamer le fichier).
  recordingPath String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Modèle utilisé pour créer cet événement (ex. "Troc annuel"), le cas
  // échéant — sert uniquement à générer les tâches à la création ; la
  // suppression du modèle ne supprime pas les événements déjà créés.
  eventTemplateId String?
  eventTemplate   EventTemplate? @relation(fields: [eventTemplateId], references: [id], onDelete: SetNull)

  signups EventSignup[]
  tasks   Task[]
}

// Modèle réutilisable pour un événement qui revient chaque année à une
// date différente (ex. le troc annuel) : titre/description/lieu par
// défaut, et une liste de tâches type avec leur échéance exprimée en
// jours avant la date de l'événement plutôt qu'en date fixe.
model EventTemplate {
  id          String   @id @default(cuid())
  name        String // libellé interne du modèle, ex. "Troc annuel"
  title       String
  description String?  @db.Text
  location    String?
  paid        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskTemplates EventTaskTemplate[]
  events        Event[]
}

// Tâche type d'un modèle d'événement. À la création d'un événement depuis
// ce modèle, une Task est générée avec dueDate = date de l'événement -
// daysBeforeEvent jours (une valeur négative donne donc une échéance après
// l'événement, ex. pour un rapport ou une synthèse) ; reminderDaysBefore
// est reporté tel quel sur la tâche générée (voir Task.reminderDaysBefore).
model EventTaskTemplate {
  id                 String        @id @default(cuid())
  eventTemplateId    String
  eventTemplate      EventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Cascade)
  title              String
  description        String?       @db.Text
  daysBeforeEvent    Int
  reminderDaysBefore Int?
  order              Int           @default(0)
}

model EventSignup {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantsReminder      Boolean   @default(false)
  reminderSentAt     DateTime?
  seekingReplacement Boolean   @default(false)
  // Un pull de la ludothèque est prêté pour cet événement — pense-bête pour
  // le récupérer à la fin (le pull lui-même, taille/coupe, reste sur le profil).
  pullLoaned         Boolean   @default(false)
  createdAt          DateTime  @default(now())

  attendanceSessions AttendanceSession[]

  @@unique([eventId, userId])
}

// Tâche optionnelle liée à un événement (pas tous les événements n'en ont).
model Task {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  // Rappel push envoyé aux assigné·e·s N jours avant dueDate (null = pas de
  // rappel). 0 = le jour même de l'échéance. Voir checkAndSendTaskReminders.
  reminderDaysBefore Int?
  reminderSentAt     DateTime?

  assignees TaskAssignee[]

  @@index([eventId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// Un créneau d'ouverture (jour + site + période) tel que défini par la
// grille hebdomadaire fixe (voir src/lib/planning.ts). Créé à la demande
// dès qu'un·e bénévole y est assigné·e.
// site : "NYON" | "GLAND". période : "JOURNEE" | "MATIN" | "APREM".
model OpeningShift {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  site      String
  periode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees OpeningShiftAssignee[]

  @@unique([date, site, periode])
  @@index([date])
}

// Modification manuelle apportée à la proposition de répartition
// automatique du planning (test, voir Espace organisation > Planning >
// Tester la répartition automatique), pour corriger un ou deux créneaux
// que l'algorithme aurait mal proposés sans relancer tout le calcul. Une
// ligne par créneau modifié ; userIds est la liste des identifiants
// bénévole choisis manuellement, séparés par des virgules (ordre =
// ordre d'affichage). "Réinitialiser" (voir actions/autoSchedule.ts)
// supprime toutes les lignes d'un mois pour repartir de la proposition
// calculée par l'algorithme.
model AutoScheduleOverride {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  site      String
  periode   String
  userIds   String
  updatedAt DateTime @updatedAt

  @@unique([date, site, periode])
  @@index([date])
}

// Fermeture globale de la ludothèque (vacances scolaires, jours fériés
// exceptionnels, etc.), saisie par un·e responsable/comité et affichée sur
// le planning des ouvertures (public et gestion). Distincte des Vacation,
// qui sont l'indisponibilité d'un·e bénévole en particulier.
model PlanningClosure {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model OpeningShiftAssignee {
  id                     String       @id @default(cuid())
  shiftId                String
  shift                  OpeningShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Le bénévole reste responsable du créneau tant que ce champ est actif :
  // signaler un empêchement ne le retire pas automatiquement.
  seekingReplacement     Boolean      @default(false)
  replacementRequestedAt DateTime?
  // Rempli dès qu'une alerte "créneau à risque" a été envoyée aux
  // responsables/comité pour ce remplacement en attente, pour ne pas
  // renvoyer la même alerte à chaque vérification périodique. Remis à
  // null dès que la recherche est annulée ou relancée.
  problemAlertSentAt     DateTime?
  // Rempli dès que le rappel "la veille à 19h" a été envoyé pour cette
  // assignation, pour ne pas le renvoyer en cas de nouvelle vérification.
  reminderSentAt         DateTime?
  // Fonction (une des EXCEL_FONCTIONS — voir planning.ts) sous laquelle
  // ce/cette bénévole a été saisi·e à l'import du planning Excel, affichée
  // sur les cases du calendrier. Nulle pour une assignation faite
  // directement depuis l'écran de gestion (pas de fonction choisie) ;
  // reprise telle quelle quand quelqu'un·e prend le relais via "Je
  // remplace" (voir fulfillShiftReplacement).
  fonction               String?

  @@unique([shiftId, userId])
  @@index([userId])
}

// Un bénévole peut arriver/repartir plusieurs fois pendant un même
// événement : chaque présence est une session distincte, et le temps
// total est la somme des sessions.
model AttendanceSession {
  id            String      @id @default(cuid())
  eventSignupId String
  eventSignup   EventSignup @relation(fields: [eventSignupId], references: [id], onDelete: Cascade)
  arrivedAt     DateTime
  leftAt        DateTime?
  manual        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([eventSignupId])
}
