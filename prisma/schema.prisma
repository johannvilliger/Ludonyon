// Ludonyon — schéma de base de données
// Association de bénévoles d'une ludothèque : bénévoles, annonces, événements et inscriptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite ne supporte pas les enums natifs : Role est une chaîne validée
// côté application (voir src/lib/roles.ts) parmi "BENEVOLE" | "RESPONSABLE" | "COMITE".
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("BENEVOLE")
  phone        String?
  skills       String? // compétences / disponibilités en texte libre
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  announcements Announcement[]
  events        Event[]
  signups       EventSignup[]

  @@index([role])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  signups EventSignup[]
}

model EventSignup {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}
