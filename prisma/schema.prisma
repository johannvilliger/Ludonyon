// Ludonyon — schéma de base de données
// Association de bénévoles d'une ludothèque : bénévoles, annonces, événements et inscriptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Role est une chaîne validée côté application (voir src/lib/roles.ts)
// parmi "BENEVOLE" | "RESPONSABLE" | "COMITE".
model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String   @default("BENEVOLE")
  active                 Boolean  @default(true)
  phone                  String?
  skills                 String? // compétences / disponibilités en texte libre
  photoPath              String? // nom de fichier dans le dossier de stockage des photos, hors dépôt git
  calendarToken          String   @unique @default(cuid())
  wantsOpeningReminders  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  announcements     Announcement[]
  events            Event[]
  signups           EventSignup[]
  vacations         Vacation[]
  taskAssignees     TaskAssignee[]
  pushSubscriptions PushSubscription[]
  openingShifts     OpeningShiftAssignee[]

  @@index([role])
}

// Un abonnement par navigateur/appareil ayant activé les notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Périodes d'indisponibilité déclarées par le bénévole lui-même,
// visibles par les responsables/comité sur sa fiche.
model Vacation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// audience : chaîne validée côté application ("ALL" | "ORGANISATION").
// "ORGANISATION" = visible uniquement des responsables/comité (ex. relais
// d'une notification envoyée à ce public restreint).
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  paid        Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  signups EventSignup[]
  tasks   Task[]
}

model EventSignup {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantsReminder      Boolean   @default(false)
  reminderSentAt     DateTime?
  seekingReplacement Boolean   @default(false)
  createdAt          DateTime  @default(now())

  attendanceSessions AttendanceSession[]

  @@unique([eventId, userId])
}

// Tâche optionnelle liée à un événement (pas tous les événements n'en ont).
model Task {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  assignees TaskAssignee[]

  @@index([eventId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// Un créneau d'ouverture (jour + site + période) tel que défini par la
// grille hebdomadaire fixe (voir src/lib/planning.ts). Créé à la demande
// dès qu'un·e bénévole y est assigné·e.
// site : "NYON" | "GLAND". période : "JOURNEE" | "MATIN" | "APREM".
model OpeningShift {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  site      String
  periode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees OpeningShiftAssignee[]

  @@unique([date, site, periode])
  @@index([date])
}

model OpeningShiftAssignee {
  id      String       @id @default(cuid())
  shiftId String
  shift   OpeningShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
}

// Un bénévole peut arriver/repartir plusieurs fois pendant un même
// événement : chaque présence est une session distincte, et le temps
// total est la somme des sessions.
model AttendanceSession {
  id            String      @id @default(cuid())
  eventSignupId String
  eventSignup   EventSignup @relation(fields: [eventSignupId], references: [id], onDelete: Cascade)
  arrivedAt     DateTime
  leftAt        DateTime?
  manual        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([eventSignupId])
}
